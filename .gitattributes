# Normalize all text files to LF in the repository (cross-platform: CI runs Windows + Linux).
* text=auto eol=lf

# Visual Studio expects CRLF in solution files.
*.sln text eol=crlf

# Scripts must stay LF even on Windows checkouts.
*.ps1 text eol=lf
*.sh  text eol=lf

# Binary assets (never normalize line endings).
*.glb  binary
*.gltf binary
*.bin  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.dds  binary
*.ktx  binary
*.exr  binary
*.tif  binary
*.tiff binary
