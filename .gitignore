# .NET build output
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test results
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage/

# NuGet
*.nupkg
*.snupkg
.nuget/

# Reference-oracle working tree (Blender/xNormal are run locally to emit goldens;
# the baked golden images under tests/golden ARE committed, the working tree is not).
tools/reference-oracle/_work/
tools/reference-oracle/*.log

# Tier-B downloaded corpus (large real assets fetched by download-corpus.ps1). The procedural
# tier-A corpus under tests/corpus/<name>/ IS committed; only the downloads are ignored.
tests/corpus/_downloads/

# OS cruft
Thumbs.db
.DS_Store

# Claude Code personal/local settings (shared .claude/settings.json may be committed)
.claude/

# Local end-to-end scratch (downloaded assets, generated meshes, ad-hoc bakes)
_e2e/

# Local FBX test assets (hand-authored game meshes; kept local, not committed)
Assets/

# Local preview renders written to the repo root by tools/*.py (kept out of git)
/*.png
/*.svg
