<Project>

  <!-- Shared settings for every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Coding standards: analyzers on, style enforced, warnings fatal. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Reproducibility (success criterion: deterministic output). -->
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Packaging metadata. -->
    <Version>1.0.0</Version>
    <Authors>Matthew Scott</Authors>
    <Product>NormalBake</Product>
    <Copyright>Copyright (c) 2026 Matthew Scott</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mattscott/normalbake</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mattscott/normalbake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>normal-map;baking;mesh;mikktspace;bvh;texture;gamedev;ambient-occlusion;dds</PackageTags>
  </PropertyGroup>

  <!-- Embed source-control metadata only on CI builds. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
