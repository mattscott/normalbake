<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NormalBake.Cli</RootNamespace>
    <AssemblyName>normalbake</AssemblyName>
    <Description>Command-line normal/AO/curvature/position/ID map baker (the NormalBake CLI).</Description>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installs as a global dotnet tool named 'normalbake'. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>normalbake</ToolCommandName>
    <PackageId>NormalBake.Tool</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NormalBake.Core\NormalBake.Core.csproj" />
    <ProjectReference Include="..\NormalBake.IO\NormalBake.IO.csproj" />
  </ItemGroup>

</Project>
