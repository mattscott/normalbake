<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NormalBake.Core</RootNamespace>
    <AssemblyName>NormalBake.Core</AssemblyName>
    <Description>Normal-map baker (projection ray-cast + MikkTSpace tangents + managed BVH) — managed, dependency-light.</Description>
